{
  "name": "wafersight",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first Electron desktop app for AI-assisted semiconductor wafer quality inspection — 3D wafer/die visualization, local ONNX defect classification, SPC monitoring, and a self-improving human-in-the-loop calibration layer.",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "semiconductor",
    "wafer",
    "quality-inspection",
    "spc",
    "onnxruntime",
    "sqlite"
  ],
  "main": "dist-electron/main.js",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Da-Wei Lin",
    "email": "dawei.lin7689@gmail.com",
    "url": "https://www.linkedin.com/in/da-wei-lin-689a35107/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deadislove/WaferSight.git"
  },
  "bugs": {
    "url": "https://github.com/deadislove/WaferSight/issues"
  },
  "homepage": "https://github.com/deadislove/WaferSight#readme",
  "scripts": {
    "predev": "rimraf dist dist-electron",
    "dev": "concurrently \"vite build --watch\" \"wait-on dist-electron/main.js && electron .\"",
    "build": "tsc -b && vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.ezoom.wafersight",
    "productName": "WaferSight",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "differentialPackage": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "i18next": "^26.4.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "onnxruntime-web": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.14",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.28",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.1.0"
  }
}
